# =============================================================================
# BIST Takip — örnek konfigürasyon
#
# Bu dosyayı `.env` adıyla kopyalayıp kendi bilgilerinle doldur:
#     cp .env.example .env
#
# `.env` dosyasını ASLA versiyon kontrolüne ekleme (.gitignore'da hariç tutuldu).
# =============================================================================

# -----------------------------------------------------------------------------
# E-POSTA (SMTP) — zorunlu
# -----------------------------------------------------------------------------
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# ÖNEMLİ: Gmail'de normal hesap şifren çalışmaz. 2 Adımlı Doğrulamayı açıp
# "Uygulama Şifresi" (App Password) oluşturman ve onu buraya yazman gerekir.
# Adımlar README'de "Gmail Uygulama Şifresi" bölümünde.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ornek@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30

# Gönderen bilgisi (boş bırakılırsa SMTP_USER kullanılır)
MAIL_FROM=ornek@gmail.com
MAIL_FROM_NAME=BIST Takip

# Alıcı(lar) — birden fazlaysa virgülle ayır
MAIL_TO=ornek@gmail.com

# -----------------------------------------------------------------------------
# ZAMANLAMA
# -----------------------------------------------------------------------------
# Günlük rapor saati (piyasa kapanışı sonrası). TIMEZONE'a göre yorumlanır.
DAILY_SEND_TIME=18:30
TIMEZONE=Europe/Istanbul

# Hafta sonu rapor gönderilmesin (piyasa kapalı)
SKIP_WEEKENDS=true

# Gün içi ek kontroller (opsiyonel). INTRADAY_ENABLED=true yaparsan
# INTRADAY_TIMES'daki saatlerde de rapor gönderilir.
INTRADAY_ENABLED=false
INTRADAY_TIMES=11:00,15:00

# -----------------------------------------------------------------------------
# VERİ KAYNAKLARI
# -----------------------------------------------------------------------------
# Fiyat sağlayıcı önceliği — sırayla denenir, ilk çalışan kullanılır.
PRICE_PROVIDERS=borsapy,yfinance

# KAP bildirimleri: kaç gün geriye bakılsın, en fazla kaç bildirim gösterilsin
KAP_LOOKBACK_DAYS=1
KAP_MAX_ITEMS=8

# Google News RSS (KAP'ı tamamlayıcı genel haber kaynağı)
NEWS_ENABLED=true
NEWS_LOOKBACK_HOURS=36
NEWS_MAX_ITEMS=5

# Analist hedef fiyatları — bulunamazsa rapor yine gönderilir
ANALYSTS_ENABLED=true

# Ağ ayarları
REQUEST_TIMEOUT=20
# Eşzamanlı hisse işleme sayısı. Kaynaklara nazik davranmak için 8 ile
# sınırlıdır; ayrıca istekler arasında otomatik gecikme uygulanır.
MAX_WORKERS=4
# Tüm rapor çalıştırması için üst süre sınırı (saniye). Yanıt vermeyen bir
# veri kaynağının zamanlayıcıyı süresiz dondurmasını engeller.
RUN_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# ALARMLAR
# -----------------------------------------------------------------------------
# Hisse bazında eşik girilmemişse kullanılacak varsayılan yüzde.
# Günlük değişim ±%5'i aşarsa e-postada alarm olarak işaretlenir.
DEFAULT_ALERT_PCT=5.0

# -----------------------------------------------------------------------------
# WEB ARAYÜZÜ
# -----------------------------------------------------------------------------
# GÜVENLİK: Varsayılan 127.0.0.1'dir; arayüze yalnızca kendi bilgisayarından
# erişilir. Bunu değiştirmeden önce README'deki "Güvenlik Notları" bölümünü oku.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Werkzeug hata ayıklayıcısı tarayıcıdan Python kodu çalıştırmaya izin verir.
# Yalnızca localhost'a bağlıyken etkinleşir; aksi halde uygulama zorla kapatır.
FLASK_DEBUG=false

# FLASK_SECRET_KEY'i BOŞ BIRAK.
# Boşsa uygulama kriptografik olarak güçlü bir anahtar üretip
# `data/secret_key` dosyasına 0600 izinle kaydeder. Buraya elle bir değer
# yazacaksan `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# çıktısını kullan — tahmin edilebilir bir anahtar oturum çerezlerinin
# taklit edilmesine izin verir.
FLASK_SECRET_KEY=

# -----------------------------------------------------------------------------
# GÜVENLİK
# -----------------------------------------------------------------------------
# Host başlığı izinli listesi (DNS rebinding savunması).
# localhost ve 127.0.0.1 her zaman kabul edilir. Uygulamaya bir ağ adıyla
# erişeceksen buraya ekle: ALLOWED_HOSTS=bist.evim.lan
ALLOWED_HOSTS=

# Kimlik doğrulama (opsiyonel — yalnızca localhost kullanımında gerekmez).
# FLASK_HOST localhost dışı bir değere ayarlanırsa bunlardan biri ZORUNLUDUR,
# aksi halde uygulama başlamayı reddeder.
#
# Seçenek A — token: tarayıcıda http://.../?token=DEGER ile giriş yaparsın.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
# Seçenek B — kullanıcı adı + şifre (HTTP Basic). Şifre en az 12 karakter.
AUTH_USER=
AUTH_PASSWORD=

# HTTPS ardında (ters proxy) çalıştırıyorsan true yap — oturum çerezi
# yalnızca şifreli bağlantıda gönderilir.
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# DOSYA YOLLARI VE LOG
# -----------------------------------------------------------------------------
DB_PATH=data/bist.db
LOG_PATH=logs/bist.log
LOG_LEVEL=INFO
